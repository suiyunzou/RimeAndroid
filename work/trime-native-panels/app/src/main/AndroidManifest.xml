<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Screenshot-to-chat shortcut: reads only the newest screenshot on demand. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Optional, user-enabled suggestions from newly received verification messages. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- User-initiated dictionary/model downloads; typing and audio remain local. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        ACCESS_NETWORK_STATE 是普通权限（normal），安装时不弹窗、用户无感，
        仅用于读取「当前是否联网 / 是否 Wi-Fi」，不涉及任何用户数据。

        此前这里用 tools:node="remove" 主动移除了它，导致两类实际故障：
          1. WorkManager 初始化时无条件调用 ConnectivityManager.getActiveNetworkInfo()，
             没有该权限会抛 SecurityException 并 FATAL EXCEPTION 杀死进程
             （K80 实测：androidx.work.impl.constraints.trackers.NetworkStateTracker）；
          2. 任何带 setRequiredNetworkType 的 WorkRequest 会被系统直接拒绝调度
             （SecurityException: ACCESS_NETWORK_STATE required for jobs with a
             connectivity constraint），后台任务永远不执行。
        为保证「自动更新」可用且不崩溃，这里恢复该权限。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name="com.osfans.trime.TrimeApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/offline_data_extraction_rules"
        android:icon="@mipmap/ic_app_icon"
        android:label="@string/trime_app_name"
        android:roundIcon="@mipmap/ic_app_icon_round"
        android:theme="@style/Theme.TrimeAppTheme"
        android:hasFragileUserData="true"
        tools:targetApi="29">

        <service
            android:name=".ime.core.TrimeInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name=".provider.RimeDataProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:directBootAware="true"
            android:exported="false"
            tools:node="merge">
            <!-- remove WorkManager default initializer -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".ui.height.HeightActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/KeyboardHeightTheme"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />

        <activity
            android:name=".ime.smart.SmartSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity
            android:name=".ime.smart.SmsCodeSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <receiver
            android:name=".ime.smart.SmsCodeReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".ime.smart.CorrectionStyleActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity
            android:name=".ime.smart.ReferenceHeightActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity android:name=".ime.smart.OfflinePrivacyActivity" android:exported="false"
            android:excludeFromRecents="true" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".ime.smart.FeedbackTuningActivity" android:exported="false"
            android:excludeFromRecents="true" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".ime.smart.LocalDictionaryActivity" android:exported="false"
            android:excludeFromRecents="true" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".ime.smart.ModelManagerActivity" android:exported="false"
            android:excludeFromRecents="true" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".ime.smart.WordLibraryActivity" android:exported="false"
            android:excludeFromRecents="true" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <!-- Invisible activity used only to ask for RECORD_AUDIO from the IME service. -->
        <activity
            android:name=".ime.voice.VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Invisible activity used only to ask for screenshot read access. -->
        <activity
            android:name=".ime.screenshot.TransparentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Settings activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.LogActivity"
            android:directBootAware="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.settings.theme.ThemeDiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.ClipEditActivity"
            android:autoRemoveFromRecents="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:label="@string/edit"
            android:launchMode="singleInstance"
            android:taskAffinity=".ui.main.LiquidKeyboardEditActivity"
            android:theme="@style/Theme.DialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />

        <!-- Using an activity alias to disable/enable the app icon in the launcher -->
        <activity-alias
            android:name="com.osfans.trime.MainLauncherAlias"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:targetActivity=".ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name="com.osfans.trime.BlueLauncherAlias"
            android:enabled="false" android:exported="true" android:label="@string/trime_app_name"
            android:icon="@drawable/ic_smart_blue" android:targetActivity=".ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="com.osfans.trime.GreenLauncherAlias"
            android:enabled="false" android:exported="true" android:label="@string/trime_app_name"
            android:icon="@drawable/ic_smart_green" android:targetActivity=".ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- All activities must be declared above <activity-alias> tag -->
    </application>
</manifest>
